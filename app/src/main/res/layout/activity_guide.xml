<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 顶部标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2196F3">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="操作指南"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#FFFFFF"
            android:contentDescription="返回按钮"
            android:layout_alignParentLeft="true" />
    </RelativeLayout>

    <!-- 内容区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar" 
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 功能介绍 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="教室人数清点助手使用指南"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:textColor="#212121" />

            <!-- 操作步骤卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="步骤1：拍摄照片"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:textColor="#2196F3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点击首页的'拍摄照片'按钮，进入相机模式。确保光线充足，将整个教室区域纳入画面范围内。"
                    android:textSize="14sp"
                    android:textColor="#616161"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="步骤2：选择区域"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:textColor="#2196F3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="拍摄前，请选择合适的识别区域，系统会针对不同区域进行优化识别。"
                    android:textSize="14sp"
                    android:textColor="#616161"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="步骤3：人数识别与修正"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:textColor="#2196F3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="系统自动识别照片中的人数后，您可以：\n1. 长按空白区域添加手动标记\n2. 点击现有标记进行删除或确认\n3. 使用缩放手势放大查看细节\n4. 通过撤销/重做按钮修改操作\n5. 一键清空手动标记或恢复系统标记"
                    android:textSize="14sp"
                    android:textColor="#616161"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="步骤4：查看历史记录"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:textColor="#2196F3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="识别完成后，结果将自动保存。点击首页的'历史记录'按钮，您可以查看过去的识别结果，包括日期、时间、教室区域和人数统计信息。"
                    android:textSize="14sp"
                    android:textColor="#616161"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <!-- 注意事项 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF8E1"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ 注意事项"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:textColor="#FF9800" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 保持相机稳定，避免模糊画面\n• 在光线充足的环境下拍摄效果更佳\n• 对于识别不准确的情况，请使用手动标记功能修正\n• 系统会自动保存识别结果，可在历史记录中查询"
                    android:textSize="14sp"
                    android:textColor="#795548"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

            <!-- 版本信息 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="版本：1.0.0"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:gravity="center"
                android:layout_marginTop="24dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 用于正确定位ScrollView的顶部占位 -->
    <View
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp" />
</RelativeLayout>